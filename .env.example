# Copie este arquivo para ".env" (não commitado) e preencha com os valores
# do seu projeto Supabase: Project Settings -> API.
# A anon key é pra ficar pública mesmo (embutida no frontend) — a segurança
# vem das políticas de Row Level Security do banco, não do sigilo dela.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
